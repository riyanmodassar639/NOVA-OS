set default=0

insmod tga
background_image ($root)/boot/grub/xbmc.tga
set color_normal=cyan/blue
set color_highlight=white/blue


menuentry "Debian GNU/Linux - live" {
linux		/casper/vmlinuz-5.15.0-194-generic boot=casper config 
initrd		/casper/initrd.img-5.15.0-194-generic
}
menuentry "Debian GNU/Linux - live (fail-safe mode)" {
linux		/casper/vmlinuz-5.15.0-194-generic boot=casper config  memtest noapic noapm nodma nomce nolapic nomodeset nosmp nosplash vga=normal
initrd		/casper/initrd.img-5.15.0-194-generic
}
menuentry "Debian GNU/Linux - live, kernel 5.15.0-194-generic" {
linux		/casper/vmlinuz-5.15.0-194-generic boot=casper config 
initrd		/casper/initrd.img-5.15.0-194-generic
}
menuentry "Debian GNU/Linux - live, kernel 5.15.0-194-generic (fail-safe mode)" {
linux		/casper/vmlinuz-5.15.0-194-generic boot=casper config  memtest noapic noapm nodma nomce nolapic nomodeset nosmp nosplash vga=normal
initrd		/casper/initrd.img-5.15.0-194-generic
}




